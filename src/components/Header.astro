---
import type { Translations } from '../i18n/en';
import type { Lang } from '../i18n/index';

interface Props {
  t: Translations;
  lang: Lang;
}

const { t, lang } = Astro.props;
const altLang  = lang === 'en' ? 'de' : 'en';
const altPath  = Astro.url.pathname.replace(`/${lang}`, `/${altLang}`);
const base     = `/${lang}`;
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 border-b border-bridge-950/80 bg-[var(--c-bg-blur)] backdrop-blur-md transition-all"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">

    {/* Logo */}
    <a href={`${base}/`} class="flex items-center gap-3 group" aria-label="open bridge server home">
      <img
        src="/logo/obs_icon_dark.svg"
        alt="open bridge server icon"
        width="36"
        height="36"
        class="rounded-lg transition-transform group-hover:scale-105"
      />
      <span class="font-mono text-sm font-medium text-[var(--c-text-1)] hidden sm:block">
        open <span class="text-[var(--c-accent)]">bridge</span>
      </span>
    </a>

    {/* Desktop nav */}
    <nav class="hidden md:flex items-center gap-6 text-sm text-[var(--c-text-2)]">
      <a href={`${base}/#about`}     class="hover:text-[var(--c-accent)] transition-colors">{t.nav.what}</a>
      <a href={`${base}/#protocols`} class="hover:text-[var(--c-accent)] transition-colors">{t.nav.protocols}</a>
      <a href={`${base}/#features`}  class="hover:text-[var(--c-accent)] transition-colors">{t.nav.features}</a>
      <a href={`${base}/#install`}   class="hover:text-[var(--c-accent)] transition-colors">{t.nav.install}</a>
      <a href={`${base}/#generator`} class="hover:text-[var(--c-accent)] transition-colors">{t.nav.generator}</a>
      <a href={`${base}/#demo`}               class="hover:text-[var(--c-accent)] transition-colors">{t.nav.demo}</a>
      <a href={`${base}/docs/erste-schritte`} class="hover:text-[var(--c-accent)] transition-colors">{t.nav.docs}</a>
    </nav>

    {/* Right actions */}
    <div class="flex items-center gap-3">
      {/* Theme toggle */}
      <button
        id="theme-toggle"
        class="rounded-md p-1.5 text-[var(--c-text-2)] hover:text-[var(--c-accent)] transition-colors"
        aria-label="Toggle light/dark theme"
      >
        {/* Sun icon — shown in dark mode */}
        <svg id="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        {/* Moon icon — shown in light mode */}
        <svg id="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      {/* Language switcher */}
      <a
        href={altPath}
        aria-label={t.nav.lang_switch_label}
        class="rounded-md border border-bridge-900 px-2.5 py-1 font-mono text-xs text-[var(--c-text-2)] hover:border-bridge-700 hover:text-[var(--c-accent)] transition-colors"
      >
        {t.nav.lang_switch}
      </a>

      {/* GitHub */}
      <a
        href="https://github.com/abeggled/openbridgeserver"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 rounded-md bg-bridge-900/60 px-3 py-1.5 text-xs font-medium text-white hover:bg-bridge-900 transition-colors"
        aria-label={t.nav.github}
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        {t.nav.github}
      </a>

      {/* Mobile menu toggle */}
      <button
        id="menu-toggle"
        class="md:hidden rounded-md p-1.5 text-[var(--c-text-2)] hover:text-[var(--c-accent)] transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg id="icon-close" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile nav */}
  <nav
    id="mobile-nav"
    class="hidden md:hidden border-t border-bridge-950 bg-[var(--c-bg)] px-4 py-4"
  >
    <ul class="flex flex-col gap-3 text-sm text-[var(--c-text-2)]">
      <li><a href={`${base}/#about`}     class="block hover:text-[var(--c-accent)] transition-colors">{t.nav.what}</a></li>
      <li><a href={`${base}/#protocols`} class="block hover:text-[var(--c-accent)] transition-colors">{t.nav.protocols}</a></li>
      <li><a href={`${base}/#features`}  class="block hover:text-[var(--c-accent)] transition-colors">{t.nav.features}</a></li>
      <li><a href={`${base}/#install`}   class="block hover:text-[var(--c-accent)] transition-colors">{t.nav.install}</a></li>
      <li><a href={`${base}/#generator`} class="block hover:text-[var(--c-accent)] transition-colors">{t.nav.generator}</a></li>
      <li><a href={`${base}/#demo`}               class="block hover:text-[var(--c-accent)] transition-colors">{t.nav.demo}</a></li>
      <li><a href={`${base}/docs/erste-schritte`} class="block hover:text-[var(--c-accent)] transition-colors">{t.nav.docs}</a></li>
    </ul>
  </nav>
</header>

<script>
  // Theme toggle
  const themeBtn = document.getElementById('theme-toggle');
  const iconSun  = document.getElementById('icon-sun');
  const iconMoon = document.getElementById('icon-moon');

  function applyTheme(dark: boolean) {
    document.documentElement.classList.toggle('dark', dark);
    iconSun?.classList.toggle('hidden', !dark);
    iconMoon?.classList.toggle('hidden', dark);
  }

  // Init icons based on current state
  applyTheme(document.documentElement.classList.contains('dark'));

  themeBtn?.addEventListener('click', () => {
    const nowDark = !document.documentElement.classList.contains('dark');
    localStorage.setItem('theme', nowDark ? 'dark' : 'light');
    applyTheme(nowDark);
  });

  // Mobile menu
  const toggle = document.getElementById('menu-toggle');
  const nav    = document.getElementById('mobile-nav');
  const iconMenu  = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    iconMenu?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  });

  nav?.querySelectorAll('a').forEach(a =>
    a.addEventListener('click', () => {
      nav.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    })
  );

  // Shrink header on scroll
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('py-2', window.scrollY > 40);
  }, { passive: true });
</script>
