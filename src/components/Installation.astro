---
import type { Translations } from '../i18n/en';

interface Props { t: Translations; }
const { t } = Astro.props;
const lxc = t.install.lxc;
---

<section id="install" class="py-24 sm:py-32 bg-[var(--c-bg-alt)]">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

    <div class="mx-auto max-w-2xl text-center mb-12">
      <h2 class="font-mono text-3xl font-medium text-[var(--c-text-1)] sm:text-4xl">{t.install.title}</h2>
      <p class="mt-4 text-sm text-[var(--c-text-2)]">{t.install.subtitle}</p>
    </div>

    <p class="text-sm text-[var(--c-text-2)] leading-relaxed mb-10">{lxc.intro}</p>

    <div class="flex flex-col gap-8">
      {lxc.steps.map((step, idx) => (
        <div class="flex gap-4">
          {/* Step number */}
          <div class="flex-shrink-0 flex h-7 w-7 items-center justify-center rounded-full border border-bridge-900/60 font-mono text-xs text-bridge-600">
            {idx + 1}
          </div>

          <div class="flex-1 min-w-0 pt-0.5">
            <p class="font-mono text-sm font-medium text-[var(--c-text-1)] mb-3">{step.title}</p>

            {'items' in step && step.items && (
              <ul class="flex flex-col gap-1.5 mb-3">
                {step.items.map((item) => (
                  <li class="flex gap-2 text-xs text-[var(--c-text-3)] leading-relaxed">
                    <span class="mt-1 flex-shrink-0 h-1.5 w-1.5 rounded-full bg-bridge-700/60"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}

            {'code' in step && step.code && (
              <div class="relative group/code rounded-lg border border-bridge-950/60 bg-[var(--c-bg-code)] overflow-hidden">
                <div class="flex items-center justify-between px-3 py-1.5 border-b border-bridge-950/40">
                  <div class="flex gap-1.5">
                    <span class="h-2.5 w-2.5 rounded-full bg-bridge-950"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-bridge-950"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-bridge-950"></span>
                  </div>
                  <button
                    class="copy-btn opacity-0 group-hover/code:opacity-100 transition font-mono text-[10px] text-bridge-700 hover:text-bridge-400 px-2 py-0.5 rounded"
                    data-code={step.code}
                  >
                    copy
                  </button>
                </div>
                <pre class="overflow-x-auto px-4 py-3 font-mono text-xs leading-relaxed text-[var(--c-code-text)]"><code>{step.code}</code></pre>
              </div>
            )}

            {'note' in step && step.note && (
              <div class="mt-2 rounded-md border border-bridge-950/40 bg-bridge-950/20 px-3 py-2.5">
                {step.note.split('\n').map((line: string) => (
                  <p class="text-xs text-[var(--c-text-3)] leading-relaxed">{line}</p>
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 rounded-lg border-l-2 border-bridge-700 bg-bridge-950/20 px-4 py-3">
      <p class="text-xs text-[var(--c-text-3)] leading-relaxed">
        <span class="font-mono font-medium text-[var(--c-accent)]">Tip: </span>
        {lxc.tip}
      </p>
    </div>

  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(btn.dataset.code ?? '');
      const orig = btn.textContent;
      btn.textContent = 'copied!';
      btn.classList.add('text-[var(--c-accent)]');
      setTimeout(() => { btn.textContent = orig; btn.classList.remove('text-[var(--c-accent)]'); }, 1800);
    });
  });
</script>
