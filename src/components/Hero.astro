---
import type { Translations } from '../i18n/en';
import type { Lang } from '../i18n/index';

interface Props {
  t: Translations;
  lang: Lang;
}

const { t, lang } = Astro.props;

// Fetch latest release version from GitHub at build time (including pre-releases)
let version = 'v0.1';
if (import.meta.env.PROD) {
  try {
    const res = await fetch('https://api.github.com/repos/abeggled/openbridgeserver/releases', {
      signal: AbortSignal.timeout(3000),
      headers: { 'Accept': 'application/vnd.github+json' },
    });
    if (res.ok) {
      const releases = await res.json();
      if (Array.isArray(releases) && releases.length > 0 && releases[0].tag_name) {
        version = releases[0].tag_name;
      }
    }
  } catch { /* fallback to static version */ }
}

const badge = `Open Source · MIT · ${version}`;
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20">

  {/* Radial glow */}
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] rounded-full bg-bridge-900/20 blur-[120px]"></div>
    <div class="absolute top-1/2 left-1/4 w-[400px] h-[400px] rounded-full bg-bridge-950/30 blur-[80px]"></div>
  </div>

  {/* Grid pattern */}
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.04]"
    style="background-image: linear-gradient(#5dcaa5 1px, transparent 1px), linear-gradient(90deg, #5dcaa5 1px, transparent 1px); background-size: 40px 40px;"
  ></div>

  <div class="relative mx-auto max-w-5xl px-4 py-24 text-center sm:px-6 lg:px-8">

    {/* Badge */}
    <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-bridge-900/70 bg-bridge-950/50 px-4 py-1.5">
      <span class="h-1.5 w-1.5 rounded-full bg-bridge-300 animate-pulse"></span>
      <span class="font-mono text-xs text-bridge-400">{badge}</span>
    </div>

    {/* Bridge SVG icon — large */}
    <div class="mx-auto mb-8 w-24 h-24 flex items-center justify-center">
      <img
        src="/logo/obs_icon_dark.svg"
        alt="openbridge server"
        width="96"
        height="96"
        class="rounded-2xl drop-shadow-[0_0_32px_rgba(93,202,165,0.3)]"
      />
    </div>

    {/* Title */}
    <h1 class="font-mono text-5xl font-medium leading-tight tracking-tight sm:text-6xl lg:text-7xl">
      <span class="text-[var(--c-text-1)]">{t.hero.title_line1}</span>
      <br />
      <span class="text-bridge-300">{t.hero.title_line2}</span>
      <br />
      <span class="text-[var(--c-text-1)]">{t.hero.title_line3}</span>
    </h1>

    {/* Subtitle */}
    <p class="mx-auto mt-8 max-w-2xl text-base text-[var(--c-text-2)] leading-relaxed sm:text-lg">
      {t.hero.subtitle}
    </p>

    {/* CTAs */}
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href={`#install`}
        class="rounded-lg bg-bridge-700 px-6 py-3 font-mono text-sm font-medium text-[var(--c-text-1)] shadow-lg shadow-bridge-950/50 transition hover:bg-bridge-600 hover:shadow-bridge-900/60"
      >
        {t.hero.cta_start}
      </a>
      <a
        href="https://github.com/abeggled/openbridgeserver"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 rounded-lg border border-bridge-900/60 bg-transparent px-6 py-3 font-mono text-sm font-medium text-[var(--c-text-2)] transition hover:border-bridge-700 hover:text-bridge-300"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        {t.hero.cta_github}
      </a>
    </div>

    {/* Stats */}
    <div class="mx-auto mt-16 grid max-w-2xl grid-cols-2 gap-px sm:grid-cols-4 overflow-hidden rounded-xl border border-bridge-950/80">
      {t.hero.stats.map((s) => (
        <div class="bg-[var(--c-bg-card60)] px-6 py-5 text-center">
          <div class="font-mono text-2xl font-medium text-bridge-300">{s.value}</div>
          <div class="mt-0.5 text-xs text-[var(--c-text-4)]">{s.label}</div>
        </div>
      ))}
    </div>

  </div>

  {/* Scroll indicator */}
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-bridge-800 animate-bounce">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M12 5v14M5 12l7 7 7-7"/>
    </svg>
  </div>

</section>
