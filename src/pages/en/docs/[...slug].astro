---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { en as t } from '../../../i18n/en';

const lang = 'en' as const;

export async function getStaticPaths() {
  const docs = await getCollection('docs', ({ id }) => id.startsWith('en/'));
  return docs.map(doc => ({
    params: { slug: doc.id.replace('en/', '').replace(/\.mdx?$/, '') },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);
const currentSlug = doc.id.replace('en/', '').replace(/\.mdx?$/, '');
---

<DocsLayout t={t} lang={lang} title={doc.data.title} description={doc.data.description} headings={headings} currentSlug={currentSlug}>
  <Content />
</DocsLayout>
