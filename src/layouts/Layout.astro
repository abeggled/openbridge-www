---
import type { Translations } from '../i18n/en';
import type { Lang } from '../i18n/index';

interface Props {
  t: Translations;
  lang: Lang;
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const { t, lang, title, description, canonicalUrl } = Astro.props;
const pageTitle = title ?? t.meta.title;
const pageDesc  = description ?? t.meta.description;
const altLang   = lang === 'en' ? 'de' : 'en';
const altPath   = Astro.url.pathname.replace(`/${lang}`, `/${altLang}`);
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDesc} />
    <title>{pageTitle}</title>

    {/* Prevent flash of wrong theme */}
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Canonical + hreflang */}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="alternate" hreflang={lang}    href={Astro.url.pathname} />
    <link rel="alternate" hreflang={altLang} href={altPath} />
    <link rel="alternate" hreflang="x-default" href="/de/" />

    {/* Fonts: Inter + DM Mono via Google Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {/* Open Graph */}
    <meta property="og:type"        content="website" />
    <meta property="og:title"       content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image"       content="/og-image.png" />

    <style is:global>
      :root {
        --c-bg:         #f7faf8;
        --c-bg-alt:     #eff5f1;
        --c-bg-card60:  rgba(220, 237, 228, 0.6);
        --c-bg-card40:  rgba(220, 237, 228, 0.4);
        --c-bg-card:    #dceee5;
        --c-bg-hover:   #d0e8dc;
        --c-bg-hover60: rgba(208, 232, 220, 0.6);
        --c-bg-blur:    rgba(247, 250, 248, 0.85);
        --c-bg-code:    #e8f0eb;
        --c-placeholder:#a0aca6;
        --c-text-1:     #1a1c1a;
        --c-text-2:     #4d5450;
        --c-text-3:     #6b706d;
        --c-text-4:     #8a8f8c;
        --c-text-5:     #9da3a0;
        --c-accent:     #15654e; /* bridge-700 — 6.9:1 on light bg */
        --c-code-text:  #15654e;
      }
      .dark {
        --c-bg:         #0a0f0d;
        --c-bg-alt:     #080d0b;
        --c-bg-card60:  rgba(13, 22, 17, 0.6);
        --c-bg-card40:  rgba(13, 22, 17, 0.4);
        --c-bg-card:    #0d1611;
        --c-bg-hover:   #0f1a14;
        --c-bg-hover60: rgba(15, 26, 20, 0.6);
        --c-bg-blur:    rgba(10, 15, 13, 0.8);
        --c-bg-code:    #050807;
        --c-placeholder:#333330;
        --c-text-1:     #f0eeea;
        --c-text-2:     #888780;
        --c-text-3:     #666663;
        --c-text-4:     #555552;
        --c-text-5:     #444441;
        --c-accent:     #5dcaa5; /* bridge-300 */
        --c-code-text:  #9fe1cb; /* bridge-200 */
      }
    </style>
  </head>
  <body class="bg-[var(--c-bg)] text-[var(--c-text-1)] font-sans antialiased selection:bg-bridge-900 selection:text-bridge-200">
    <slot />
  </body>
</html>
